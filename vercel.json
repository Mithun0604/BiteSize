{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "excludeFiles": [
        "node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "server/**/*.test.js"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api?path=uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
