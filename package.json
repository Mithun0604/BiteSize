{
  "name": "bitesize-platform",
  "version": "1.0.0",
  "description": "BiteSize - AI-Powered Nutrition & Grocery Intelligence Platform",
  "main": "api/index.js",
  "scripts": {
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "test": "node --test",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install && npm run build",
    "start": "node server/index.js"
  },
  "keywords": [
    "nutrition",
    "grocery-intelligence",
    "ai",
    "receipt-scanner",
    "meal-recognition"
  ],
  "author": "BiteSize Team",
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "razorpay": "^2.9.4",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
